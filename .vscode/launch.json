{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "netlog | WSL Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/netlog",
            "args": [
                "--input",
                "data/incident",
                "--threads",
                "2"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "CMake: 构建 netlog"
        }
    ]
}
