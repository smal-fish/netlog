    file(WRITE "${TEST_DIR}/c.log" "")
    set(expected "read_lines=4\nvalid_records=2\ninvalid_records=2\n${device_header}dev 2 1 50.00% 20.00 30\n${event_header}OK 1\nTIMEOUT 1\n")
    set(diagnostics "a[.]log:1: expected exactly 5 fields\n[^\n]*b[.]log:2: expected exactly 5 fields\n")
