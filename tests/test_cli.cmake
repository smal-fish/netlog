    set(first "1700000000 dev01 INFO REQ_OK 100\n1700000001 dev01 ERROR TIMEOUT 900\n")
    set(second "1700000002 dev02 INFO REQ_OK 200\n1700000003 dev01 INFO REQ_OK 200\n1700000004 dev02 ERROR CRC_ERROR 400\nbroken_line\n")
    file(WRITE "${folder}/b.log" "${second}")
    file(WRITE "${folder}/a.log" "${first}")
    file(WRITE "${folder}/nested/skip.log" "0 ignored INFO IGNORED 1\n")
    file(WRITE "${folder}/skip.txt" "0 ignored INFO IGNORED 1\n")
    set(expected "read_lines=6\nvalid_records=5\ninvalid_records=1\n${device_header}dev01 3 1 33.33% 400.00 900\ndev02 2 1 50.00% 300.00 400\n${event_header}REQ_OK 3\nCRC_ERROR 1\nTIMEOUT 1\n")
    check_cli(split 0 "${expected}" "b[.]log:4: expected exactly 5 fields" --input "${folder}")
